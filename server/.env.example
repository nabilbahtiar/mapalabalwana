# Database PostgreSQL (Supabase / Neon / Local PostgreSQL)
# Catatan: Jika menggunakan Supabase, ambil dari Project Settings -> Database
# DATABASE_URL menggunakan Transaction Pooler (Port 6543)
DATABASE_URL="postgresql://postgres:[PASSWORD]@[HOST]:6543/postgres?pgbouncer=true"

# DIRECT_URL menggunakan Direct Connection (Port 5432) untuk Prisma Migrate
DIRECT_URL="postgresql://postgres:[PASSWORD]@[HOST]:5432/postgres"

# Supabase Storage & API Credentials
# Diambil dari Project Settings -> API di dashboard Supabase
SUPABASE_URL="https://[PROJECT-REF].supabase.co"
SUPABASE_KEY="[YOUR-SUPABASE-ANON-OR-SERVICE-KEY]"

# JWT Secret untuk token otentikasi login admin (buat string acak/bebas)
JWT_SECRET="ganti_dengan_kode_rahasia_jwt_acak_yang_aman_12345"

# Server Port (Default: 5000 atau 3000)
PORT=5000

